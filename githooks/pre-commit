#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# Gate pre-commit — ESLint (staged .js/.jsx) + tsc --noEmit.
#
# Por qué ESLint y no solo tsc: este proyecto es JS/JSX con `checkJs:
# false`, así que tsc NO verifica los .jsx. Un estado React eliminado
# por una edición (p. ej. `showMoreOptions`) compila con esbuild sin
# error y solo explota en runtime — pero ESLint `no-undef` (error en
# eslint:recommended) sí lo detecta en segundos.
#
# Bypass en emergencias:  git commit --no-verify
# Desactivar el gate:     git config --unset core.hooksPath
# ─────────────────────────────────────────────────────────────────────

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx)$' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "[pre-commit] ESLint en archivos staged..."
    # shellcheck disable=SC2086
    if ! bunx eslint $STAGED_FILES; then
        echo ""
        echo "❌ [pre-commit] ESLint encontró errores en los archivos del commit. Abortado."
        echo "   Corrige los errores arriba (o justifica un bypass con 'git commit --no-verify')."
        exit 1
    fi
    echo "✅ [pre-commit] ESLint OK."
else
    echo "[pre-commit] Sin archivos .js/.jsx staged — ESLint omitido."
fi

echo "[pre-commit] tsc --noEmit (cubre .ts y configs futuras)..."
if ! bun run typecheck; then
    echo ""
    echo "❌ [pre-commit] El typecheck falló. El commit fue abortado."
    exit 1
fi

echo "✅ [pre-commit] Gate completo OK."
exit 0
